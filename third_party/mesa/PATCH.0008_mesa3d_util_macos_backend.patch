@@ -0,0 +1,70 @@
+// Copyright 2026 Mesa3D authors
+// SPDX-License-Identifier: MIT
+
+use std::ffi::CStr;
+use std::os::fd::AsRawFd;
+use std::os::fd::IntoRawFd;
+use std::os::unix::io::OwnedFd;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+use rustix::fs::ftruncate;
+use rustix::fs::Mode;
+use rustix::shm;
+
+use crate::descriptor::AsRawDescriptor;
+use crate::descriptor::IntoRawDescriptor;
+use crate::MesaResult;
+use crate::RawDescriptor;
+
+static SHM_COUNTER: AtomicU64 = AtomicU64::new(0);
+
+pub struct SharedMemory {
+    fd: OwnedFd,
+    size: u64,
+}
+
+impl SharedMemory {
+    /// Creates a new shared memory file descriptor with the given size.
+    ///
+    /// macOS has no `memfd_create`, so this is `shm_open` followed by an
+    /// immediate `shm_unlink`: the name leaves the namespace while the open
+    /// descriptor keeps the object alive.
+    pub fn new(_debug_name: &CStr, size: u64) -> MesaResult<SharedMemory> {
+        let counter = SHM_COUNTER.fetch_add(1, Ordering::Relaxed);
+        // shm names on macOS are limited to PSHMNAMLEN (31) characters.
+        let name = format!("/mesa-{}-{}", std::process::id(), counter);
+
+        let fd = shm::open(
+            name.as_str(),
+            shm::OFlags::CREATE | shm::OFlags::EXCL | shm::OFlags::RDWR,
+            Mode::RUSR | Mode::WUSR,
+        )?;
+        shm::unlink(name.as_str())?;
+
+        ftruncate(&fd, size)?;
+
+        Ok(SharedMemory { fd, size })
+    }
+
+    /// Gets the size in bytes of the shared memory.
+    pub fn size(&self) -> u64 {
+        self.size
+    }
+}
+
+impl AsRawDescriptor for SharedMemory {
+    fn as_raw_descriptor(&self) -> RawDescriptor {
+        self.fd.as_raw_fd()
+    }
+}
+
+impl IntoRawDescriptor for SharedMemory {
+    fn into_raw_descriptor(self) -> RawDescriptor {
+        self.fd.into_raw_fd()
+    }
+}
+
+pub fn page_size() -> MesaResult<u64> {
+    Ok(rustix::param::page_size() as _)
+}
diff --git a/src/util/rust/sys/macos/tube.rs b/src/util/rust/sys/macos/tube.rs
new file mode 100644
index 0000000..f906131
--- /dev/null
+++ b/src/util/rust/sys/macos/tube.rs
@@ -0,0 +1,266 @@
+// Copyright 2026 Mesa3D authors
+// SPDX-License-Identifier: MIT
+
+use std::io::Error;
+use std::io::ErrorKind;
+use std::io::IoSlice;
+use std::io::IoSliceMut;
+use std::mem::MaybeUninit;
+use std::os::fd::AsFd;
+use std::path::Path;
+
+use rustix::cmsg_space;
+use rustix::fs::fcntl_getfl;
+use rustix::fs::fcntl_setfl;
+use rustix::fs::OFlags;
+use rustix::net::accept;
+use rustix::net::bind;
+use rustix::net::connect;
+use rustix::net::listen;
+use rustix::net::recvmsg;
+use rustix::net::sendmsg;
+use rustix::net::socket_with;
+use rustix::net::sockopt::set_socket_nosigpipe;
+use rustix::net::sockopt::socket_type;
+use rustix::net::AddressFamily;
+use rustix::net::RecvAncillaryBuffer;
+use rustix::net::RecvAncillaryMessage;
+use rustix::net::RecvFlags;
+use rustix::net::SendAncillaryBuffer;
+use rustix::net::SendAncillaryMessage;
+use rustix::net::SendFlags;
+use rustix::net::SocketAddrUnix;
+use rustix::net::SocketFlags;
+use rustix::net::SocketType;
+use rustix::path::Arg;
+
+use crate::AsBorrowedDescriptor;
+use crate::MesaError;
+use crate::MesaResult;
+use crate::OwnedDescriptor;
+use crate::TubeType;
+
+const MAX_IDENTIFIERS: usize = 28;
+
+// macOS AF_UNIX sockets have no SOCK_SEQPACKET, so packet tubes are emulated
+// over SOCK_STREAM. Each message is framed with an 8-byte header ([u32 payload
+// length][u32 descriptor count]); the descriptors ride on the header via
+// SCM_RIGHTS and the payload follows.
+
+// There is no MSG_NOSIGNAL either, and this runs inside a C++ host process that
+// has not reset SIGPIPE, so writing to a closed peer would kill it.
+// SO_NOSIGPIPE turns those writes into EPIPE, which callers already handle. It
+// lives on the socket object, so it also covers descriptors sent via SCM_RIGHTS.
+fn set_nosigpipe<F: AsFd>(socket: &F) -> MesaResult<()> {
+    set_socket_nosigpipe(socket, true)?;
+    Ok(())
+}
+
+pub struct Tube {
+    socket: OwnedDescriptor,
+}
+
+impl TryFrom<OwnedDescriptor> for Tube {
+    type Error = MesaError;
+
+    fn try_from(socket: OwnedDescriptor) -> Result<Self, Self::Error> {
+        let ty = socket_type(&socket)?;
+        match ty {
+            SocketType::STREAM => {
+                set_nosigpipe(&socket)?;
+                Ok(Tube { socket })
+            }
+            _ => Err(MesaError::Unsupported),
+        }
+    }
+}
+
+impl TryFrom<SocketType> for TubeType {
+    type Error = std::io::Error;
+
+    fn try_from(ty: SocketType) -> Result<Self, Self::Error> {
+        match ty {
+            // Packet tubes are emulated over STREAM, and only packet tubes are
+            // created here, so a STREAM socket is a packet tube.
+            SocketType::STREAM => Ok(TubeType::Packet),
+            ty => {
+                log::warn!("Unsupported socket type {ty:?}");
+                Err(Error::from(ErrorKind::Unsupported))
+            }
+        }
+    }
+}
+
+fn recv_exact(
+    socket: &OwnedDescriptor,
+    buf: &mut [u8],
+    fds: &mut Vec<OwnedDescriptor>,
+) -> MesaResult<()> {
+    let mut offset = 0;
+    while offset < buf.len() {
+        let mut iovecs = [IoSliceMut::new(&mut buf[offset..])];
+        let mut space = [MaybeUninit::<u8>::uninit(); cmsg_space!(ScmRights(MAX_IDENTIFIERS))];
+        let mut cmsg_buffer = RecvAncillaryBuffer::new(&mut space);
+        let r = recvmsg(socket, &mut iovecs, &mut cmsg_buffer, RecvFlags::empty())?;
+        for cmsg in cmsg_buffer.drain() {
+            if let RecvAncillaryMessage::ScmRights(received) = cmsg {
+                fds.extend(received.into_iter().map(Into::into));
+            }
+        }
+        if r.bytes == 0 {
+            return Err(MesaError::from(Error::from(ErrorKind::UnexpectedEof)));
+        }
+        offset += r.bytes;
+    }
+    Ok(())
+}
+
+fn write_all(socket: &OwnedDescriptor, mut data: &[u8]) -> MesaResult<()> {
+    while !data.is_empty() {
+        let n = rustix::io::write(socket, data)?;
+        if n == 0 {
+            return Err(MesaError::from(Error::from(ErrorKind::WriteZero)));
+        }
+        data = &data[n..];
+    }
+    Ok(())
+}
+
+impl Tube {
+    pub fn new<P: AsRef<Path> + Arg>(path: P, kind: TubeType) -> MesaResult<Tube> {
+        // Every tube here carries framed packets, so a raw byte stream would be
+        // unparseable to its peer. Refuse rather than return the wrong thing.
+        if !matches!(kind, TubeType::Packet) {
+            return Err(MesaError::Unsupported);
+        }
+
+        let socket = socket_with(
+            AddressFamily::UNIX,
+            SocketType::STREAM,
+            SocketFlags::empty(),
+            None,
+        )?;
+
+        set_nosigpipe(&socket)?;
+
+        let unix_addr = SocketAddrUnix::new(path)?;
+        connect(&socket, &unix_addr)?;
+
+        Ok(Tube {
+            socket: socket.into(),
+        })
+    }
+
+    pub fn send(&self, opaque_data: &[u8], descriptors: &[OwnedDescriptor]) -> MesaResult<usize> {
+        let data_len = opaque_data.len() as u32;
+        let num_fds = descriptors.len() as u32;
+        let mut header = [0u8; 8];
+        header[0..4].copy_from_slice(&data_len.to_ne_bytes());
+        header[4..8].copy_from_slice(&num_fds.to_ne_bytes());
+
+        let mut space = [MaybeUninit::<u8>::uninit(); cmsg_space!(ScmRights(MAX_IDENTIFIERS))];
+        let mut cmsg_buffer = SendAncillaryBuffer::new(&mut space);
+
+        let borrowed_fds: Vec<_> = descriptors.iter().map(AsFd::as_fd).collect();
+        // Only attach an SCM_RIGHTS control message when there are descriptors:
+        // sending an empty control message is not portable.
+        if !borrowed_fds.is_empty() {
+            let cmsg = SendAncillaryMessage::ScmRights(&borrowed_fds);
+            cmsg_buffer.push(cmsg);
+        }
+
+        // The header (8 bytes) is small enough to be delivered in a single
+        // sendmsg, keeping the descriptors attached to it.
+        sendmsg(
+            &self.socket,
+            &[IoSlice::new(&header)],
+            &mut cmsg_buffer,
+            SendFlags::empty(),
+        )?;
+
+        write_all(&self.socket, opaque_data)?;
+
+        Ok(opaque_data.len())
+    }
+
+    pub fn receive(&self, opaque_data: &mut [u8]) -> MesaResult<(usize, Vec<OwnedDescriptor>)> {
+        let mut header = [0u8; 8];
+        let mut received_descriptors: Vec<OwnedDescriptor> = Vec::new();
+        recv_exact(&self.socket, &mut header, &mut received_descriptors)?;
+
+        let data_len =
+            u32::from_ne_bytes([header[0], header[1], header[2], header[3]]) as usize;
+        let num_descriptors =
+            u32::from_ne_bytes([header[4], header[5], header[6], header[7]]) as usize;
+        if data_len > opaque_data.len() {
+            return Err(MesaError::WithContext("received message exceeds buffer"));
+        }
+
+        recv_exact(
+            &self.socket,
+            &mut opaque_data[..data_len],
+            &mut received_descriptors,
+        )?;
+
+        // send() records how many descriptors it attached, so a different count
+        // means a truncated or malformed message.
+        if received_descriptors.len() != num_descriptors {
+            return Err(MesaError::WithContext(
+                "received descriptor count does not match the message header",
+            ));
+        }
+
+        Ok((data_len, received_descriptors))
+    }
+}
+
+impl AsBorrowedDescriptor for Tube {
+    fn as_borrowed_descriptor(&self) -> &OwnedDescriptor {
+        &self.socket
+    }
+}
+
+pub struct Listener {
+    socket: OwnedDescriptor,
+}
+
+impl Listener {
+    /// Creates a new `Listener` bound to the given path.
+    pub fn bind<P: AsRef<Path> + Arg>(path: P) -> MesaResult<Listener> {
+        let socket = socket_with(
+            AddressFamily::UNIX,
+            SocketType::STREAM,
+            SocketFlags::empty(),
+            None,
+        )?;
+
+        let unix_addr = SocketAddrUnix::new(path)?;
+        bind(&socket, &unix_addr)?;
+        listen(&socket, 128)?;
+
+        fcntl_setfl(&socket, OFlags::NONBLOCK)?;
+
+        Ok(Listener {
+            socket: socket.into(),
+        })
+    }
+
+    pub fn accept(&self) -> MesaResult<Tube> {
+        let accepted_fd = accept(&self.socket)?;
+        let descriptor: OwnedDescriptor = accepted_fd.into();
+        set_nosigpipe(&descriptor)?;
+        // BSD accepted sockets inherit the listener's file status flags, unlike
+        // Linux, so this one arrives non-blocking. Clear it: reassembling a
+        // message takes more than one recvmsg, and those must wait for the rest
+        // rather than fail with EAGAIN.
+        let flags = fcntl_getfl(&descriptor)?;
+        fcntl_setfl(&descriptor, flags.difference(OFlags::NONBLOCK))?;
+        Ok(Tube { socket: descriptor })
+    }
+}
+
+impl AsBorrowedDescriptor for Listener {
+    fn as_borrowed_descriptor(&self) -> &OwnedDescriptor {
+        &self.socket
+    }
+}
diff --git a/src/util/rust/sys/macos/wait_context.rs b/src/util/rust/sys/macos/wait_context.rs
new file mode 100644
index 0000000..5e51474
--- /dev/null
+++ b/src/util/rust/sys/macos/wait_context.rs
@@ -0,0 +1,84 @@
+// Copyright 2026 Mesa3D authors
+// SPDX-License-Identifier: MIT
+
+use std::mem::MaybeUninit;
+use std::os::fd::OwnedFd;
+use std::ptr::null_mut;
+
+use rustix::event::kqueue::kevent;
+use rustix::event::kqueue::kqueue;
+use rustix::event::kqueue::Event;
+use rustix::event::kqueue::EventFilter;
+use rustix::event::kqueue::EventFlags;
+use rustix::io::Errno;
+
+use crate::AsRawDescriptor;
+use crate::MesaResult;
+use crate::OwnedDescriptor;
+use crate::WaitEvent;
+use crate::WaitTimeout;
+use crate::WAIT_CONTEXT_MAX;
+
+/// macOS uses kqueue rather than epoll for readiness notification.
+pub struct WaitContext {
+    kqueue: OwnedFd,
+}
+
+impl WaitContext {
+    pub fn new() -> MesaResult<WaitContext> {
+        Ok(WaitContext { kqueue: kqueue()? })
+    }
+
+    fn apply(&self, change: &Event) -> MesaResult<()> {
+        let mut events: [Event; 0] = [];
+        // SAFETY: the descriptor named by `change` is owned by the caller, which
+        // keeps it alive at least until the matching `delete` call.
+        unsafe { kevent(&self.kqueue, &[*change], &mut events[..], None)? };
+        Ok(())
+    }
+
+    pub fn add(&mut self, connection_id: u64, descriptor: &OwnedDescriptor) -> MesaResult<()> {
+        let change = Event::new(
+            EventFilter::Read(descriptor.as_raw_descriptor()),
+            EventFlags::ADD | EventFlags::ENABLE,
+            connection_id as *mut std::ffi::c_void,
+        );
+        self.apply(&change)
+    }
+
+    pub fn wait(&mut self, timeout: WaitTimeout) -> MesaResult<Vec<WaitEvent>> {
+        let timeout = match timeout {
+            WaitTimeout::Finite(duration) => Some(duration),
+            WaitTimeout::NoTimeout => None,
+        };
+
+        let mut buffer = [MaybeUninit::<Event>::uninit(); WAIT_CONTEXT_MAX];
+        let events = loop {
+            // SAFETY: the descriptors registered with `add` are owned by the
+            // caller and stay valid until they are removed with `delete`.
+            match unsafe { kevent(&self.kqueue, &[], &mut buffer[..], timeout) } {
+                Ok((events, _)) => break events,
+                Err(Errno::INTR) => continue,
+                Err(err) => return Err(err.into()),
+            }
+        };
+
+        Ok(events
+            .iter()
+            .map(|event| WaitEvent {
+                connection_id: event.udata() as u64,
+                readable: matches!(event.filter(), EventFilter::Read(_)),
+                hung_up: event.flags().contains(EventFlags::EOF),
+            })
+            .collect())
+    }
+
+    pub fn delete(&mut self, descriptor: &OwnedDescriptor) -> MesaResult<()> {
+        let change = Event::new(
+            EventFilter::Read(descriptor.as_raw_descriptor()),
+            EventFlags::DELETE,
+            null_mut(),
+        );
+        self.apply(&change)
+    }
+}
