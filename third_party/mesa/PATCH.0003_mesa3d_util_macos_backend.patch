diff --git a/src/util/rust/sys/macos/atomic_memory_sentinel.rs b/src/util/rust/sys/macos/atomic_memory_sentinel.rs
new file mode 100644
index 0000000..0071460
--- /dev/null
+++ b/src/util/rust/sys/macos/atomic_memory_sentinel.rs
@@ -0,0 +1,80 @@
+// Copyright 2025 Google
+// SPDX-License-Identifier: MIT
+
+//! Cross-domain synchronization primitives for macOS.
+//!
+//! macOS has no futex. `os_sync_wait_on_address` and its wake counterparts are
+//! the platform equivalent: they block on the value at an address and wake
+//! waiters by address, which is what the Linux backend uses futexes for. They
+//! are available since macOS 14.4.
+//!
+//! The bitset the futex API takes has no equivalent here. It is only used to
+//! filter which waiters a wake reaches, so ignoring it wakes a superset of the
+//! intended waiters; every waiter re-checks the value it was waiting on, so a
+//! spurious wake is harmless.
+
+use std::ffi::c_void;
+use std::sync::atomic::AtomicU32;
+
+const OS_SYNC_WAIT_ON_ADDRESS_NONE: u32 = 0;
+const OS_SYNC_WAKE_BY_ADDRESS_NONE: u32 = 0;
+
+extern "C" {
+    fn os_sync_wait_on_address(addr: *mut c_void, value: u64, size: usize, flags: u32) -> i32;
+    fn os_sync_wake_by_address_any(addr: *mut c_void, size: usize, flags: u32) -> i32;
+    fn os_sync_wake_by_address_all(addr: *mut c_void, size: usize, flags: u32) -> i32;
+}
+
+/// Wait until the value at `atomic_val` differs from `val`.
+pub fn wait_bitset(atomic_val: &AtomicU32, val: u32, _bitset: u32) {
+    let addr = atomic_val as *const AtomicU32 as *mut c_void;
+
+    // SAFETY: `addr` points at the caller's live `AtomicU32`, and the size
+    // passed matches it. Errors are ignored for the same reason the Linux
+    // backend ignores them: a value that already changed, or an interrupted
+    // wait, are both expected and are handled by the caller re-checking.
+    unsafe {
+        os_sync_wait_on_address(
+            addr,
+            val as u64,
+            std::mem::size_of::<u32>(),
+            OS_SYNC_WAIT_ON_ADDRESS_NONE,
+        );
+    }
+}
+
+/// Wake threads waiting on the value at `atomic_val`.
+///
+/// `val` is the number of threads to wake, or a negative value to wake all of
+/// them.
+pub fn wake_bitset(atomic_val: &AtomicU32, val: i32, _bitset: u32) {
+    let addr = atomic_val as *const AtomicU32 as *mut c_void;
+    let size = std::mem::size_of::<u32>();
+
+    // SAFETY: `addr` points at the caller's live `AtomicU32`, and the size
+    // passed matches it.
+    unsafe {
+        if val == 1 {
+            os_sync_wake_by_address_any(addr, size, OS_SYNC_WAKE_BY_ADDRESS_NONE);
+        } else {
+            // There is no "wake exactly N" call, so wake everyone. Waiters that
+            // were not meant to run re-check their value and wait again.
+            os_sync_wake_by_address_all(addr, size, OS_SYNC_WAKE_BY_ADDRESS_NONE);
+        }
+    }
+}
+
+/// Wake all threads waiting on the value at `atomic_val`.
+pub fn wake_all(atomic_val: &AtomicU32) {
+    let addr = atomic_val as *const AtomicU32 as *mut c_void;
+
+    // SAFETY: `addr` points at the caller's live `AtomicU32`, and the size
+    // passed matches it.
+    unsafe {
+        os_sync_wake_by_address_all(
+            addr,
+            std::mem::size_of::<u32>(),
+            OS_SYNC_WAKE_BY_ADDRESS_NONE,
+        );
+    }
+}
diff --git a/src/util/rust/sys/macos/descriptor.rs b/src/util/rust/sys/macos/descriptor.rs
new file mode 100644
index 0000000..8206d76
--- /dev/null
+++ b/src/util/rust/sys/macos/descriptor.rs
@@ -0,0 +1,166 @@
+// Copyright 2025 Google
+// SPDX-License-Identifier: MIT
+
+use std::fs::File;
+use std::io::Error;
+use std::io::ErrorKind;
+use std::io::Result;
+use std::os::fd::AsFd;
+use std::os::fd::BorrowedFd;
+use std::os::fd::OwnedFd;
+use std::os::unix::io::AsRawFd;
+use std::os::unix::io::FromRawFd;
+use std::os::unix::io::IntoRawFd;
+use std::os::unix::io::RawFd;
+
+use rustix::fs::fcntl_getfl;
+use rustix::fs::fstat;
+use rustix::fs::seek;
+use rustix::fs::FileType;
+use rustix::fs::OFlags;
+use rustix::fs::SeekFrom;
+use rustix::net::sockopt::socket_type;
+use rustix::net::SocketType;
+
+use crate::descriptor::AsRawDescriptor;
+use crate::descriptor::FromRawDescriptor;
+use crate::descriptor::IntoRawDescriptor;
+use crate::DescriptorType;
+use crate::MESA_HANDLE_TYPE_MEM_SHM;
+use crate::MESA_MAP_ACCESS_READ;
+use crate::MESA_MAP_ACCESS_RW;
+use crate::MESA_MAP_ACCESS_WRITE;
+
+pub type RawDescriptor = RawFd;
+pub const DEFAULT_RAW_DESCRIPTOR: RawDescriptor = -1;
+
+#[derive(Debug)]
+pub struct OwnedDescriptor {
+    owned: OwnedFd,
+}
+
+impl OwnedDescriptor {
+    pub fn try_clone(&self) -> Result<OwnedDescriptor> {
+        let clone = self.owned.try_clone()?;
+        Ok(OwnedDescriptor { owned: clone })
+    }
+
+    pub fn determine_type(&self) -> Result<DescriptorType> {
+        // macOS has no /proc/self/fd, so classify descriptors from their stat
+        // file type and open flags rather than the symlink target.
+        if let Ok(fd_stat) = fstat(&self.owned) {
+            match FileType::from_raw_mode(fd_stat.st_mode) {
+                FileType::Socket => {
+                    // Events are self-connected AF_UNIX SOCK_DGRAM sockets here
+                    // (see event.rs), and tubes are built on SOCK_STREAM, so the
+                    // socket type is what tells the two apart.
+                    let ty = socket_type(&self.owned)?;
+                    if ty == SocketType::DGRAM {
+                        return Ok(DescriptorType::Event);
+                    }
+                    return Ok(DescriptorType::Socket(ty.try_into()?));
+                }
+                FileType::Fifo => {
+                    // Only the writable end of a pipe has a type of its own; the
+                    // readable end falls through and is reported as unsupported,
+                    // the same way it is on Linux.
+                    let flags = fcntl_getfl(&self.owned)?;
+                    if (flags & OFlags::ACCMODE) == OFlags::WRONLY {
+                        return Ok(DescriptorType::WritePipe);
+                    }
+                }
+                _ => {}
+            }
+        }
+
+        match seek(&self.owned, SeekFrom::End(0)) {
+            Ok(seek_size) => {
+                let size: u32 = seek_size
+                    .try_into()
+                    .map_err(|_| Error::from(ErrorKind::Unsupported))?;
+                Ok(DescriptorType::Memory(size, MESA_HANDLE_TYPE_MEM_SHM))
+            }
+            _ => {
+                let flags = fcntl_getfl(&self.owned)?;
+                match flags & OFlags::ACCMODE {
+                    OFlags::WRONLY => Ok(DescriptorType::WritePipe),
+                    _ => Err(Error::from(ErrorKind::Unsupported)),
+                }
+            }
+        }
+    }
+
+    pub fn determine_map_access_mode(&self) -> Result<u32> {
+        let flags = fcntl_getfl(&self.owned)?;
+        // macOS has no file seals, so access is determined solely by open flags.
+        let access = match flags & OFlags::ACCMODE {
+            OFlags::RDONLY => MESA_MAP_ACCESS_READ,
+            OFlags::WRONLY => MESA_MAP_ACCESS_WRITE,
+            OFlags::RDWR => MESA_MAP_ACCESS_RW,
+            _ => return Err(Error::from(ErrorKind::Unsupported)),
+        };
+        Ok(access)
+    }
+}
+
+impl AsRawDescriptor for OwnedDescriptor {
+    fn as_raw_descriptor(&self) -> RawDescriptor {
+        self.owned.as_raw_fd()
+    }
+}
+
+impl FromRawDescriptor for OwnedDescriptor {
+    // SAFETY:
+    // It is caller's responsibility to ensure that the descriptor is valid and
+    // stays valid for the lifetime of Self
+    unsafe fn from_raw_descriptor(descriptor: RawDescriptor) -> Self {
+        OwnedDescriptor {
+            owned: OwnedFd::from_raw_fd(descriptor),
+        }
+    }
+}
+
+impl IntoRawDescriptor for OwnedDescriptor {
+    fn into_raw_descriptor(self) -> RawDescriptor {
+        self.owned.into_raw_fd()
+    }
+}
+
+impl AsFd for OwnedDescriptor {
+    fn as_fd(&self) -> BorrowedFd<'_> {
+        self.owned.as_fd()
+    }
+}
+
+impl AsRawDescriptor for File {
+    fn as_raw_descriptor(&self) -> RawDescriptor {
+        self.as_raw_fd()
+    }
+}
+
+impl FromRawDescriptor for File {
+    // SAFETY:
+    // It is caller's responsibility to ensure that the descriptor is valid and
+    // stays valid for the lifetime of Self
+    unsafe fn from_raw_descriptor(descriptor: RawDescriptor) -> Self {
+        File::from_raw_fd(descriptor)
+    }
+}
+
+impl IntoRawDescriptor for File {
+    fn into_raw_descriptor(self) -> RawDescriptor {
+        self.into_raw_fd()
+    }
+}
+
+impl From<File> for OwnedDescriptor {
+    fn from(f: File) -> OwnedDescriptor {
+        OwnedDescriptor { owned: f.into() }
+    }
+}
+
+impl From<OwnedFd> for OwnedDescriptor {
+    fn from(o: OwnedFd) -> OwnedDescriptor {
+        OwnedDescriptor { owned: o }
+    }
+}
diff --git a/src/util/rust/sys/macos/event.rs b/src/util/rust/sys/macos/event.rs
new file mode 100644
index 0000000..be0d33b
--- /dev/null
+++ b/src/util/rust/sys/macos/event.rs
@@ -0,0 +1,168 @@
+// Copyright 2025 Google
+// SPDX-License-Identifier: MIT
+
+use std::os::fd::OwnedFd;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::atomic::AtomicU32;
+use std::sync::atomic::Ordering;
+
+use rustix::fs::mkdir;
+use rustix::fs::rmdir;
+use rustix::fs::unlink;
+use rustix::fs::Mode;
+use rustix::io::read;
+use rustix::io::write;
+use rustix::io::Errno;
+use rustix::net::bind;
+use rustix::net::connect;
+use rustix::net::socket_with;
+use rustix::net::AddressFamily;
+use rustix::net::SocketAddrUnix;
+use rustix::net::SocketFlags;
+use rustix::net::SocketType;
+use rustix::process::getpid;
+
+use crate::AsBorrowedDescriptor;
+use crate::MesaError;
+use crate::MesaHandle;
+use crate::MesaResult;
+use crate::OwnedDescriptor;
+use crate::MESA_HANDLE_TYPE_SIGNAL_EVENT_FD;
+
+// macOS has no eventfd. The property the kumquat fence protocol relies on is
+// that an event is a *single* descriptor which can be both signalled (written)
+// and waited on (read), and which keeps working after being duplicated and
+// passed to another process via SCM_RIGHTS: whichever side ends up signalling,
+// the other side's wait must observe it. eventfd provides this because every
+// duplicate refers to one shared kernel object.
+//
+// A self-connected AF_UNIX SOCK_DGRAM socket has the same property: a datagram
+// written to it is placed in its own receive queue and can be read back through
+// any descriptor referring to the same socket, including a descriptor sent to a
+// different process. This makes signal/wait direction-agnostic, matching how the
+// protocol uses events (the server signals a guest-created fence in one path and
+// the guest waits on a server-created fence in another, using the same type).
+
+static EVENT_COUNTER: AtomicU32 = AtomicU32::new(0);
+
+const MAX_DIRECTORY_ATTEMPTS: u32 = 64;
+
+pub struct Event {
+    descriptor: OwnedDescriptor,
+}
+
+/// Creates a directory that only this user can enter, to hold one event socket.
+///
+/// The socket has to be bound to a path before it can be connected to itself.
+/// Binding it directly in the shared temporary directory would leave a window
+/// between choosing a name and binding it in which another local process could
+/// create a file, or a symlink, at that name: `bind()` would then fail, or follow
+/// the symlink somewhere else. `mkdir()` is atomic and fails if the name is
+/// already taken, so creating a mode 0700 directory first and binding inside it
+/// closes that window. A name can only be taken here by a directory left behind
+/// by an earlier process that had this pid, so the collision is retried.
+fn create_event_directory() -> MesaResult<PathBuf> {
+    let base = std::env::temp_dir();
+    let pid = getpid().as_raw_nonzero();
+
+    for _ in 0..MAX_DIRECTORY_ATTEMPTS {
+        let counter = EVENT_COUNTER.fetch_add(1, Ordering::Relaxed);
+        let directory = base.join(format!(".mesa-event-{}-{}", pid, counter));
+        match mkdir(&directory, Mode::RWXU) {
+            Ok(()) => return Ok(directory),
+            Err(Errno::EXIST) => continue,
+            Err(err) => return Err(err.into()),
+        }
+    }
+
+    Err(MesaError::WithContext(
+        "failed to create a directory for an event",
+    ))
+}
+
+fn bind_and_connect(socket: &OwnedFd, directory: &Path) -> MesaResult<()> {
+    let path = directory.join("event");
+    let addr = SocketAddrUnix::new(&path)?;
+
+    bind(socket, &addr)?;
+    let connected = connect(socket, &addr);
+    // The socket object outlives its name: it stays alive as long as a descriptor
+    // refers to it, and writes to it remain readable on that descriptor.
+    let _ = unlink(&path);
+    connected?;
+
+    Ok(())
+}
+
+fn create_self_connected_socket() -> MesaResult<OwnedDescriptor> {
+    let socket = socket_with(
+        AddressFamily::UNIX,
+        SocketType::DGRAM,
+        SocketFlags::empty(),
+        None,
+    )?;
+
+    let directory = create_event_directory()?;
+    let bound = bind_and_connect(&socket, &directory);
+    let _ = rmdir(&directory);
+    bound?;
+
+    Ok(socket.into())
+}
+
+impl Event {
+    pub fn new() -> MesaResult<Event> {
+        Ok(Event {
+            descriptor: create_self_connected_socket()?,
+        })
+    }
+
+    pub fn add(&mut self, value: u64) -> MesaResult<()> {
+        let _ = write(&self.descriptor, &value.to_le_bytes())?;
+        Ok(())
+    }
+
+    pub fn signal(&mut self) -> MesaResult<()> {
+        self.add(1)
+    }
+
+    pub fn wait(&mut self) -> MesaResult<u64> {
+        let mut buf = [0; 8];
+        read(&self.descriptor, &mut buf)?;
+        Ok(u64::from_le_bytes(buf))
+    }
+
+    pub fn try_clone(&self) -> MesaResult<Event> {
+        let clone = self.descriptor.try_clone()?;
+        Ok(Event { descriptor: clone })
+    }
+}
+
+impl TryFrom<MesaHandle> for Event {
+    type Error = MesaError;
+    fn try_from(handle: MesaHandle) -> Result<Self, Self::Error> {
+        if handle.handle_type != MESA_HANDLE_TYPE_SIGNAL_EVENT_FD {
+            return Err(MesaError::InvalidMesaHandle);
+        }
+
+        Ok(Event {
+            descriptor: handle.os_handle,
+        })
+    }
+}
+
+impl From<Event> for MesaHandle {
+    fn from(evt: Event) -> Self {
+        MesaHandle {
+            os_handle: evt.descriptor,
+            handle_type: MESA_HANDLE_TYPE_SIGNAL_EVENT_FD,
+        }
+    }
+}
+
+impl AsBorrowedDescriptor for Event {
+    fn as_borrowed_descriptor(&self) -> &OwnedDescriptor {
+        &self.descriptor
+    }
+}
diff --git a/src/util/rust/sys/macos/memory_mapping.rs b/src/util/rust/sys/macos/memory_mapping.rs
new file mode 100644
index 0000000..7805688
--- /dev/null
+++ b/src/util/rust/sys/macos/memory_mapping.rs
@@ -0,0 +1,93 @@
+// Copyright 2025 Google
+// SPDX-License-Identifier: MIT
+
+use std::ffi::c_void;
+use std::os::fd::AsFd;
+use std::ptr::null_mut;
+
+use rustix::mm::mmap;
+use rustix::mm::munmap;
+use rustix::mm::MapFlags;
+use rustix::mm::ProtFlags;
+
+use crate::MesaError;
+use crate::MesaResult;
+use crate::OwnedDescriptor;
+use crate::MESA_MAP_ACCESS_MASK;
+use crate::MESA_MAP_ACCESS_READ;
+use crate::MESA_MAP_ACCESS_RW;
+use crate::MESA_MAP_ACCESS_WRITE;
+
+/// Wraps an anonymous shared memory mapping in the current process. Provides
+/// RAII semantics including munmap when no longer needed.
+#[derive(Debug)]
+pub struct MemoryMapping {
+    pub addr: *mut c_void,
+    pub size: usize,
+}
+
+// SAFETY:
+// MemoryMapping user must ensure it is used by one thread at a time.
+unsafe impl Sync for MemoryMapping {}
+// SAFETY:
+// MemoryMapping user must ensure it is used by one thread at a time.
+unsafe impl Send for MemoryMapping {}
+
+impl Drop for MemoryMapping {
+    fn drop(&mut self) {
+        // SAFETY:
+        // This is safe because we mmap the area at addr ourselves, and nobody
+        // else is holding a reference to it.
+        unsafe {
+            munmap(self.addr, self.size).unwrap();
+        }
+    }
+}
+
+impl MemoryMapping {
+    fn do_mmap(
+        descriptor: &OwnedDescriptor,
+        offset: usize,
+        size: usize,
+        map_info: u32,
+    ) -> MesaResult<MemoryMapping> {
+        let prot = match map_info & MESA_MAP_ACCESS_MASK {
+            MESA_MAP_ACCESS_READ => ProtFlags::READ,
+            MESA_MAP_ACCESS_WRITE => ProtFlags::WRITE,
+            MESA_MAP_ACCESS_RW => ProtFlags::READ | ProtFlags::WRITE,
+            _ => return Err(MesaError::WithContext("incorrect access flags")),
+        };
+
+        // SAFETY:
+        // The inputs to the mmap() system call have been verified, and
+        // the kernel is trusted to deliver a correct result.
+        let addr = unsafe {
+            mmap(
+                null_mut(),
+                size,
+                prot,
+                MapFlags::SHARED,
+                descriptor.as_fd(),
+                offset.try_into().unwrap(),
+            )?
+        };
+
+        Ok(MemoryMapping { addr, size })
+    }
+
+    pub fn from_safe_descriptor(
+        descriptor: OwnedDescriptor,
+        size: usize,
+        map_info: u32,
+    ) -> MesaResult<MemoryMapping> {
+        Self::do_mmap(&descriptor, 0, size, map_info)
+    }
+
+    pub fn from_offset(
+        descriptor: &OwnedDescriptor,
+        offset: usize,
+        size: usize,
+    ) -> MesaResult<MemoryMapping> {
+        Self::do_mmap(descriptor, offset, size, MESA_MAP_ACCESS_RW)
+    }
+}
